# Environment Configuration Template
# Copy this file to .env and adjust local values as needed.
# .env is ignored by Git to prevent committing secrets or machine-specific paths.

# Hardware and Execution Settings
CUDA_VISIBLE_DEVICES=0
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# Data Directories (Relative or Absolute)
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SPLITS_DATA_DIR=data/splits

# Experiment Logging & Artifacts
LOG_LEVEL=INFO
EXPERIMENT_OUTPUT_DIR=results
RANDOM_SEED=42
